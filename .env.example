# ---------------------------------------------------------------
# FoodLoop environment configuration — copy to .env.local
# NEVER commit real secrets. All values below are placeholders.
# ---------------------------------------------------------------

# Public base URL of the app (used for links in notifications/receipts)
APP_URL=http://localhost:3000

# Demo mode: enables one-click demo accounts, the "Reset demo data" tool
# and simulated payments. Set to "false" for any public/production deployment.
DEMO_MODE=true

# Local SQLite database file (created automatically).
DATABASE_FILE=./data/foodloop.db

# Folder for uploaded food photos and protected verification documents.
UPLOAD_DIR=./storage

# ---------------- Payments (Razorpay) ----------------
# Leave blank to use the clearly labelled simulated payment flow.
# Use TEST keys (rzp_test_...) for the Razorpay sandbox.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------- Optional external notifications ----------------
# Not implemented as senders yet — in-app notifications always work.
# SMTP_URL=
# WHATSAPP_API_TOKEN=
