{
  "name": "foodloop",
  "version": "1.0.0",
  "private": true,
  "description": "FoodLoop — Rescue Food. Share Hope. Feed Communities. A food donation & rescue platform.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "create-admin": "tsx scripts/create-admin.ts",
    "setup": "npm run db:reset"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.460.0",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-is": "^19.2.9",
    "recharts": "3.10.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
